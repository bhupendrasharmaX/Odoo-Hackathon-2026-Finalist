# Copy to .env and fill in. .env is gitignored - never commit real secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL 16. Person 1 owns prisma/schema.prisma; this is the connection
# string the generated client uses.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplepay360?schema=public"

# Required in production. In development an insecure fallback is used and the
# server warns loudly at boot.
JWT_SECRET="change-me-to-something-long-and-random"
JWT_EXPIRES_IN=24h

# Comma-separated. The Vite dev server runs on 5173.
CORS_ORIGIN=http://localhost:5173

# Optional. With SMTP unset, send-payslips logs the send and still records it
# as sent, so the demo works offline.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="PeoplePay360 <no-reply@peoplepay.com>"

COMPANY_NAME="PeoplePay360"
